<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvRankingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Bảng xếp hạng"
        android:textColor="#4C1D95"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRankingStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_stat_pill"
        android:gravity="center"
        android:padding="12dp"
        android:text="Đang tải bảng xếp hạng..."
        android:textColor="#831843"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_glass"
        android:elevation="8dp"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/layoutRankingList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btnBackHome"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button_secondary"
        android:text="Về trang chủ"
        android:textAllCaps="false"
        android:textColor="@color/button_text_white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
