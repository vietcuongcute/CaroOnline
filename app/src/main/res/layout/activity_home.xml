<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_app_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/tvHomeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:gravity="center"
            android:text="Caro Online"
            android:textColor="#4C1D95"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUserInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Xin chào"
            android:textColor="#7C3AED"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_stat_pill"
            android:elevation="4dp"
            android:gravity="center"
            android:padding="16dp"
            android:text="Thắng: 0 | Thua: 0 | Hòa: 0 | Điểm: 0"
            android:textColor="#831843"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_glass"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="18dp">

            <Button
                android:id="@+id/btnPlayAI"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_button_primary"
                android:elevation="6dp"
                android:text="🤖 Chơi với AI"
                android:textAllCaps="false"
                android:textColor="@color/button_text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPlayOnline"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_primary"
                android:elevation="6dp"
                android:text="⚡ Chơi Online"
                android:textAllCaps="false"
                android:textColor="@color/button_text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnHistory"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_secondary"
                android:text="📜 Lịch sử đấu"
                android:textAllCaps="false"
                android:textColor="@color/button_text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRanking"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_secondary"
                android:text="🏆 Bảng xếp hạng"
                android:textAllCaps="false"
                android:textColor="@color/button_text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAbout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_purple"


                android:text="💜 Thông tin
"
                android:textAllCaps="false"
                android:textColor="@color/button_text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_button_danger"
                android:text="Đăng xuất"
                android:textAllCaps="false"
                android:textColor="@color/button_text_white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
